# --- AI harness (template-ai-harness) ---
# Files the harness writes locally at runtime; never commit them.
# Per-user agent settings (Claude Code):
.claude/settings.local.json
# Transient scratch state, written by ./AGENTS.sh verify:
.agents/agents.scratch.json
# Cross-session lock, held while ./AGENTS.sh runs:
.agents/agents.json.lock
# Python bytecode cache from running the harness CLI:
.agents/__pycache__/

# --- Project ---
# Node / deps
node_modules/
npm-debug.log*
# Build output
dist/
.wrangler/
# Cloudflare Workers types (generated)
worker-configuration.d.ts
# Secrets / local env — NEVER commit
.dev.vars
.dev.vars.*
*.pem
.env
.env.*
# OS / editor noise
.DS_Store
*.swp
.idea/
.vscode/
